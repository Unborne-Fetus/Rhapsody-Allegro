config_version=5
[application]
config/name="Rhapsody: Allegro"
config/version="0.2.0"
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043,0.063,0.098,1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="A hybrid-perspective action boss rush."
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=640
window/size/min_height=360
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035,0.045,0.065,1)
textures/default_filters/use_nearest_mipmap_filter=false
[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=false
